# Ads Action Engine environment template.
#
# Copy to .env with `make init ADMIN_PASSWORD=...`. Never commit .env.
# Blank values are treated as unset (defaults apply).
# Secrets are empty here and must only ever be set in .env on the server.
# Missing source credentials are not an error: that source runs on simulated data with the
# reason "credentials not configured".
#
# Docker Compose injects this file (as .env) into the migrate, api and worker services; the db
# service receives only the POSTGRES_* values. Nothing here reaches the browser bundle, and no
# VITE_ variable exists.
# Format: plain KEY=value lines; comments sit on their own lines, never after a value.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# Database created by the db service (Compose interpolates POSTGRES_* into it).
POSTGRES_DB=ads_engine
# Database user created by the db service.
POSTGRES_USER=ads
# local only; change for any shared host and update DATABASE_URL to match.
POSTGRES_PASSWORD=ads
# SQLAlchemy URL; must match POSTGRES_* above; host `db` is the Compose service.
DATABASE_URL=postgresql+psycopg://ads:ads@db:5432/ads_engine
# http:// is accepted only for localhost/127.0.0.1; any other host needs https:// and TLS in
# front of nginx (docs/runbook.md); https makes the session cookie Secure.
APP_BASE_URL=http://localhost:8080
# IANA time zone; formats instants only; never moves a source's day boundary.
DISPLAY_TIMEZONE=UTC
# auto: per-source live with automatic simulated fallback; simulated: force every source
# simulated, never probe. A shell DATA_MODE overrides this through Compose interpolation.
DATA_MODE=auto
# Seed for simulated data (deterministic tests and demos).
MOCK_SEED=42
# Initial backfill per new dataset, in days; every source (Google, LinkedIn, HubSpot) is
# capped at 180 days, LinkedIn's 6-month daily retention, so a larger value reads 180.
BACKFILL_DAYS=180

# -----------------------------------------------------------------------------
# Google Ads via n8n
# Google Ads is reached ONLY through the existing n8n Cloud webhook. No Google client ID,
# secret, refresh token or developer token belongs here.
# -----------------------------------------------------------------------------

# n8n webhook URL that relays googleAds:search v25, one GAQL query per call; never logged.
# Must be https://; plain http:// is accepted only on localhost or 127.0.0.1.
N8N_GOOGLE_ADS_WEBHOOK_URL=
# Header name configured on the n8n Header Auth credential. The existing credential expects
# X-Webhook-Token and rejects X-Webhook-Secret, the code default used when this is blank.
N8N_WEBHOOK_SECRET_HEADER=X-Webhook-Token
# Shared secret sent in that header (secret).
N8N_WEBHOOK_SECRET=
# Google Ads customer id: 10 digits, no dashes.
GOOGLE_ADS_CUSTOMER_ID=
# Product's own cap on webhook calls per sliding 24 h (quota is shared with other n8n workflows).
GOOGLE_DAILY_CALL_BUDGET=1000

# -----------------------------------------------------------------------------
# LinkedIn Marketing API
# Read-only scopes r_ads, r_ads_reporting, r_marketing_leadgen_automation. Provide the
# refresh-token trio OR a static access token. Bootstrap: docs/runbook.md
# -----------------------------------------------------------------------------

# Comma-separated numeric sponsored account ids.
LINKEDIN_AD_ACCOUNT_IDS=
# OAuth client id of the refresh-token trio.
LINKEDIN_CLIENT_ID=
# OAuth client secret of the refresh-token trio (secret).
LINKEDIN_CLIENT_SECRET=
# Refresh token of the trio (secret); exchanged for an access token held in memory only.
LINKEDIN_REFRESH_TOKEN=
# Static access token, the alternative to the trio (secret); the trio wins when both are set.
LINKEDIN_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# HubSpot CRM
# -----------------------------------------------------------------------------

# Service Key or private-app token; read scopes for contacts, deals, meetings (secret).
HUBSPOT_ACCESS_TOKEN=
# Optional contact property holding the Google campaign id; both Google properties must be
# set and verified to link Google to CRM.
HUBSPOT_GOOGLE_CAMPAIGN_PROPERTY=
# Optional datetime contact property for the Google touch.
HUBSPOT_GOOGLE_TOUCH_DATE_PROPERTY=

# -----------------------------------------------------------------------------
# Admin and session
# -----------------------------------------------------------------------------

# Non-secret bootstrap identity; ensure-admin creates/updates this user.
APP_ADMIN_EMAIL=admin@example.com
# written by make init; single-quoted because the argon2 hash contains $
APP_ADMIN_PASSWORD_HASH=
# written by make init (random); signs the session cookie.
SESSION_SECRET=
