# Ads Action Engine: the shell's DATA_MODE for migrate, api and worker (docker-compose.yml,
# x-backend). Compose reads this file after .env, and only when DATA_MODE interpolates
# non-empty, so a non-blank shell value overrides .env and a blank one leaves .env in force.
# Compose interpolates the value below; it holds no secret and no default.
DATA_MODE=${DATA_MODE}
