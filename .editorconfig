root = true

# EditorConfig: https://editorconfig.org
# Editor defaults that agree with the project's formatters and linters:
# ruff format for Python, ESLint with typescript-eslint and stylelint for web/.
# Comments sit on their own lines; the specification does not allow inline comments.

# Every file, unless a later section overrides it. YAML, JSON, TOML, TypeScript,
# JavaScript, CSS, HTML, Dockerfiles, nginx.conf and shell use 2-space indentation.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python: PEP 8 four-space indentation, as written by `ruff format`.
# max_line_length: keep in sync with [tool.ruff] line-length in backend/pyproject.toml.
[*.{py,pyi}]
indent_size = 4
max_line_length = 100

# backend/pyproject.toml uses four-space arrays, the layout `uv add` and `uv remove` write.
[pyproject.toml]
indent_size = 4

# make requires a literal tab before every recipe line.
[{Makefile,*.mk}]
indent_style = tab

# Two trailing spaces are a Markdown hard line break.
[*.md]
trim_trailing_whitespace = false
